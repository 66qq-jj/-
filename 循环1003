#include <stdio.h>
int main()
{
	int i,j,c,k,f;
	char ch,ch1;
	scanf("%c",&ch);
    c=ch-64;
	//printf("%d",c);
	for (i=1;i<=c;i++)
	{
		for (f=c-1;f>=i;f--)
		{
			printf(" ");
		}
		ch1='A';
		for (j=1;j<=i;j++)
		{
			printf("%c",ch1);
			ch1++;
		}
				ch=('A'+i)-2;
		for (k=1;k<=i-1;k++)
		{
			printf("%c",ch--);
		}
		printf("\n");
	}
}
